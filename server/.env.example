# Generate private values with npm run setup. Never commit .env.
NODE_ENV=development
DATA_KEY=
INVITE_CODE=
REGISTRATION_MODE=invite
OPENAI_API_KEY=
OPENAI_MODEL=
RESEND_API_KEY=
MAIL_FROM=
SUPPORT_EMAIL=
OPERATOR_NAME=
PUBLIC_ORIGIN=
REQUIRE_EMAIL_VERIFICATION=true
MODERATION_ENABLED=true
# Enable only behind the supplied Caddy proxy; never expose API port directly.
TRUST_PROXY=false
HOST=0.0.0.0
PORT=8080
DB_PATH=data/raabta.db
DAILY_AI_MESSAGES=30
GLOBAL_DAILY_AI_CALLS=500
GLOBAL_HOURLY_EMAILS=100
